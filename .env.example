# Variables para docker compose (copiar a .env)
DB_NAME=smartcompost

# Clave para firmar los tokens de inicio de sesion.
# Cambiela si no es un entorno de pruebas.
JWT_SECRET_KEY=dev-secret-change-me

# Clave que envia el ESP32 en la cabecera X-API-Key (igual en el firmware)
IOT_API_KEY=dev-iot-key-change-me

# Calibracion de los sensores de gas (ver firmware/GUIA_CONEXIONES.md)
MQ_RL_KOHM=10
MQ2_R0_KOHM=10
MQ135_R0_KOHM=10
