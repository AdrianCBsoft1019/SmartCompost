# Copia este archivo como ".env" y ajusta los valores reales.
# Nunca subas el archivo ".env" real al repositorio (agregalo a .gitignore).

# --- Base de datos MySQL (XAMPP) ---
# Valores por defecto de XAMPP: host 127.0.0.1, puerto 3306, usuario root sin contrasena.
# Antes de correr el backend, crea la base de datos vacia "smartcompost" desde phpMyAdmin
# (http://localhost/phpmyadmin -> Nueva -> nombre "smartcompost" -> Crear). Las tablas
# las crea automaticamente la app la primera vez que arranca.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartcompost
DB_USER=root
DB_PASSWORD=

# --- Seguridad / JWT ---
JWT_SECRET_KEY=cambia-esta-clave-por-una-generada-con-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
